@startuml Diagrama_Robustez_CU25_Gestionar_Cambios_Devoluciones_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU25
' Caso de Uso: CU25 - Gestionar Cambios y Devoluciones de Prendas
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU25 Cambios y Devoluciones**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cajero / Encargado\nde Atención al Cliente" as ActCajero

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Cambios y Devoluciones" as B_DevView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU25_DevolucionController" as C_Dev

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Venta" as E_Venta
entity "DetalleVenta" as E_Detalle
entity "Inventario" as E_Inv
entity "MovimientoInventario" as E_Mov
entity "Usuario" as E_User
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCajero -- B_DevView : <font color="#1B2631">1: verificarVentaOriginal(venta_id) -></font>\n<font color="#1B2631">1.7: mostrarPrendasAptasParaCambio() -></font>\n<font color="#C0392B">2: ejecutarCambioPrenda(item_id, nueva_variante_id) -></font>\n<font color="#C0392B">2.8: comprobanteCambioGenerado() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_DevView -- C_Dev : <font color="#1B2631">1.1: validar_venta(venta_id, plazo_dias=15) -></font>\n<font color="#1B2631">1.6: ventaValidaResponse() -></font>\n<font color="#C0392B">2.1: procesar_cambio(payload) -></font>\n<font color="#C0392B">2.7: cambioExitosoResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Dev -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.6: asociarAlTenant() -></font>
C_Dev -- E_User : <font color="#1B2631">1.3: findByAuthToken(cajero_id) -></font>
C_Dev -- E_Venta : <font color="#1B2631">1.4: findOrFail(venta_id)->validarPlazo15Dias() -></font>
C_Dev -- E_Detalle : <font color="#1B2631">1.5: with('prendas_vendidas')->get() -></font>
C_Dev -- E_Inv : <font color="#C0392B">2.2: reintegrarPrendaDevuelta(variante_antigua) -></font>\n<font color="#C0392B">2.3: descontarNuevaPrenda(variante_nueva) -></font>
C_Dev -- E_Mov : <font color="#C0392B">2.4: createMany(ENTRADA_DEVOLUCION, SALIDA_CAMBIO) -></font>
C_Dev -- E_Bitacora : <font color="#C0392B">2.5: create(AUDIT_CAMBIO_DEVOLUCION) -></font>

@enduml
