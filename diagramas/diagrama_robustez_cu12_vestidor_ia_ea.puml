@startuml Diagrama_Robustez_CU12_Vestidor_Virtual_IA_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU12
' Caso de Uso: CU12 - Utilizar Vestidor Virtual Mediante IA
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU12 Vestidor Virtual con IA**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cliente / Comprador\nDigital" as ActCliente

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Modal : Vestidor Virtual IA" as B_VestidorModal #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU12_VestidorIaController" as C_Vestidor

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "PruebaVirtual" as E_Prueba
entity "Usuario" as E_User
entity "Producto" as E_Prod
entity "Tenant" as E_Tenant

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCliente -- B_VestidorModal : <font color="#1B2631">1: subirFotoYPedirAjuste(foto, prod_id) -></font>\n<font color="#1B2631">1.7: mostrarTallaSugeridaYAjuste() -></font>\n<font color="#C0392B">2: generarSimulacionPrenda(foto, prenda) -></font>\n<font color="#C0392B">2.7: mostrarRenderizadoPrendaPuesta() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_VestidorModal -- C_Vestidor : <font color="#1B2631">1.1: analizar_fisonomia_y_ajuste(imagen, producto) -></font>\n<font color="#1B2631">1.6: analisisFisonomiaResponse() -></font>\n<font color="#C0392B">2.1: probar_prenda_virtual(imagen, prompt) -></font>\n<font color="#C0392B">2.6: simulacionGeneradaResponse(url) -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Vestidor -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.5: descontarCuotaUsoIA() -></font>
C_Vestidor -- E_User : <font color="#1B2631">1.3: findByAuthToken() -></font>\n<font color="#C0392B">2.4: asociarAlHistorialUsuario() -></font>
C_Vestidor -- E_Prod : <font color="#1B2631">1.4: findOrFail(producto_id)->getFichaTecnica() -></font>\n<font color="#C0392B">2.2: with('textura', 'corte')->get() -></font>
C_Vestidor -- E_Prueba : <font color="#1B2631">1.5: create(tipo='ANALISIS_FISONOMIA') -></font>\n<font color="#C0392B">2.3: update(['imagen_generada_url' => url]) -></font>

@enduml
