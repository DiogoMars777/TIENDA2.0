@startuml Diagrama_Robustez_CU05_Gestionar_Productos_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU05
' Caso de Uso: CU05 - Gestionar Productos y Catálogo Retail
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU05 Gestionar Productos**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Administrador /\nEncargado de Almacen" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES) - Colores distintos por cada vista
boundary "Page : Lista de Productos" as B_ProdList #AED6F1
boundary "Modal : Formulario Producto" as B_ProdForm #A9DFBF

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU05_ProductoController" as C_Prod

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Producto" as E_Producto
entity "Categoria" as E_Categoria
entity "VarianteProducto" as E_Variante
entity "Tenant" as E_Tenant
entity "PlanSuscripcion" as E_Plan
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_ProdList : <font color="#1B2631">1: consultarProductos(search, cat, genero) -></font>\n<font color="#1B2631">1.6: mostrarCatalogoProductos() -></font>
ActAdmin -- B_ProdForm : <font color="#C0392B">2: ingresarDatosPrenda(form) -></font>\n<font color="#C0392B">2.9: prendaGuardadaExito() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_ProdList -- C_Prod : <font color="#1B2631">1.1: listar_productos(Request) -></font>\n<font color="#1B2631">1.5: listaProductosResponse() -></font>
B_ProdForm -- C_Prod : <font color="#C0392B">2.1: store() / update() / baja_logica() -></font>\n<font color="#C0392B">2.8: prendaProcesada() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Prod -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Prod -- E_Producto : <font color="#1B2631">1.3: filter(tenant_id, activo)->paginate() -></font>\n<font color="#1B2631">1.4: with('variantes')->get() -></font>\n<font color="#C0392B">2.4: findByCodigo() -></font>\n<font color="#C0392B">2.5: create() / update(['activo'=>estado]) -></font>
C_Prod -- E_Plan : <font color="#C0392B">2.2: validarLimiteProductos(plan_id) -></font>
C_Prod -- E_Categoria : <font color="#C0392B">2.3: findOrFail(categoria_id) -></font>
C_Prod -- E_Variante : <font color="#C0392B">2.6: syncVariantes(tallas, colores, SKUs) -></font>
C_Prod -- E_Bitacora : <font color="#C0392B">2.7: create(AUDIT_PRODUCTO) -></font>

@enduml
