@startuml Diagrama_Robustez_CU06_Gestionar_Clasificacion_Prendas_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU06
' Caso de Uso: CU06 - Gestionar Clasificación de Prendas (Categorías, Temporadas, Colecciones)
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU06 Gestionar Clasificacion de Prendas**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Administrador /\nDiseñador de Modas" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES) - Colores distintos por cada vista
boundary "Page : Lista de Clasificaciones" as B_ClasList #AED6F1
boundary "Modal : Formulario Clasificación" as B_ClasModal #A9DFBF

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU06_ClasificacionController" as C_Clas

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Categoria" as E_Cat
entity "Temporada" as E_Temp
entity "Coleccion" as E_Col
entity "Producto" as E_Prod
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_ClasList : <font color="#1B2631">1: consultarClasificaciones(search, activo) -></font>\n<font color="#1B2631">1.8: mostrarPanelClasificaciones() -></font>
ActAdmin -- B_ClasModal : <font color="#C0392B">2: ingresarDatosClasificacion(form) -></font>\n<font color="#C0392B">2.8: clasificacionGuardadaExito() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_ClasList -- C_Clas : <font color="#1B2631">1.1: listar_categorias_temporadas(Request) -></font>\n<font color="#1B2631">1.7: retornarListadosResponse() -></font>
B_ClasModal -- C_Clas : <font color="#C0392B">2.1: store() / update() / baja_logica() -></font>\n<font color="#C0392B">2.7: clasificacionProcesada() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Clas -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Clas -- E_Cat : <font color="#1B2631">1.3: filter(tenant_id)->all() -></font>\n<font color="#C0392B">2.2: create(categoria) / update(['activo'=>estado]) -></font>
C_Clas -- E_Temp : <font color="#1B2631">1.4: filter(fechas_vigencia)->all() -></font>\n<font color="#C0392B">2.3: create(temporada) / validarRangoFechas() -></font>
C_Clas -- E_Col : <font color="#1B2631">1.5: with('temporada')->all() -></font>\n<font color="#C0392B">2.4: create(coleccion) / sync(temporada_id) -></font>
C_Clas -- E_Prod : <font color="#1B2631">1.6: countPrendasVinculadas() -></font>\n<font color="#C0392B">2.5: validarIntegridadPrendas(baja_logica) -></font>
C_Clas -- E_Bitacora : <font color="#C0392B">2.6: create(AUDIT_CLASIFICACION) -></font>

@enduml
