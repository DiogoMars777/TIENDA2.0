@startuml Diagrama_Robustez_CU20_Generar_Reportes_Generativos_IA_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU20
' Caso de Uso: CU20 - Generar Reportes Generativos con IA
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU20 Reportes Generativos con IA**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Administrador / Gerente\nGeneral" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Reportes Generativos IA" as B_RepView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU20_ReporteGenerativoController" as C_Rep

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "ReporteGenerativo" as E_Reporte
entity "Usuario" as E_User
entity "Tenant" as E_Tenant

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_RepView : <font color="#1B2631">1: escribirPromptAnalitico(prompt, filtros) -></font>\n<font color="#1B2631">1.7: renderizarGraficosYReporteGenerado() -></font>\n<font color="#C0392B">2: consultarHistorialReportes() -></font>\n<font color="#C0392B">2.6: mostrarListaReportesPrevios() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_RepView -- C_Rep : <font color="#1B2631">1.1: generar_reporte(Request) -></font>\n<font color="#1B2631">1.6: reporteSintetizadoResponse() -></font>\n<font color="#C0392B">2.1: listar_historial(tenant_id) -></font>\n<font color="#C0392B">2.5: historialReportesResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Rep -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#1B2631">1.5: registrarConsumoTokenIA() -></font>\n<font color="#C0392B">2.4: asociarAlTenant() -></font>
C_Rep -- E_User : <font color="#1B2631">1.3: findByAuthToken() -></font>\n<font color="#C0392B">2.2: validarPermisoEjecutivo() -></font>
C_Rep -- E_Reporte : <font color="#1B2631">1.4: create(prompt, respuesta_ia, data_json) -></font>\n<font color="#C0392B">2.3: filter(tenant_id)->orderBy('fecha', 'desc')->get() -></font>

@enduml
