@startuml Diagrama_Robustez_CU10_Gestionar_Reservas_Prendas_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU10
' Caso de Uso: CU10 - Gestionar Reservas de Prendas
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU10 Gestionar Reservas de Prendas**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cliente / Comprador\nRegistrado" as ActCliente

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Mis Reservas de Prendas" as B_ResView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU10_ReservaController" as C_Res

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Reserva" as E_Reserva
entity "ReservaDetalle" as E_Detalle
entity "Carrito" as E_Carrito
entity "CarritoItem" as E_Item
entity "Inventario" as E_Inv
entity "Sucursal" as E_Suc
entity "VarianteProducto" as E_Variante
entity "Producto" as E_Prod
entity "Usuario" as E_User
entity "Tenant" as E_Tenant

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCliente -- B_ResView : <font color="#1B2631">1: confirmarReserva(sucursal_id) -></font>\n<font color="#1B2631">1.12: mostrarCodigoReservaYPlazo48h() -></font>\n<font color="#C0392B">2: consultarMisReservas() / cancelar(id) -></font>\n<font color="#C0392B">2.7: listaReservasActualizada() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_ResView -- C_Res : <font color="#1B2631">1.1: crear_reserva(usuario_id, datos) -></font>\n<font color="#1B2631">1.11: reservaCreadaResponse() -></font>\n<font color="#C0392B">2.1: listar_reservas() / cancelar_reserva() -></font>\n<font color="#C0392B">2.6: estadoReservaResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Res -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Res -- E_Carrito : <font color="#1B2631">1.3: loadActiveCart(usuario_id) -></font>
C_Res -- E_Item : <font color="#1B2631">1.4: loadCartItems(carrito_id) -></font>
C_Res -- E_Variante : <font color="#1B2631">1.5: findOrFail(variante_id) -></font>
C_Res -- E_Prod : <font color="#1B2631">1.6: with('prenda_catalogo')->get() -></font>
C_Res -- E_Suc : <font color="#1B2631">1.7: findOrFail(sucursal_id) -></font>
C_Res -- E_Inv : <font color="#1B2631">1.8: bloquearStockTemporal(horas=48) -></font>\n<font color="#C0392B">2.5: liberarStockBloqueadoADisponible() -></font>
C_Res -- E_Reserva : <font color="#1B2631">1.9: create(codigo, estado='PENDIENTE') -></font>\n<font color="#C0392B">2.3: filter(usuario_id)->get() / update(CANCELADA) -></font>
C_Res -- E_Detalle : <font color="#1B2631">1.10: createMany(prendas_reservadas) -></font>\n<font color="#C0392B">2.4: with('items')->get() -></font>
C_Res -- E_User : <font color="#C0392B">2.2: findByAuthToken() -></font>

@enduml
