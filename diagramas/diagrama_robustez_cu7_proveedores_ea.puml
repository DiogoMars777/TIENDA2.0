@startuml Diagrama_Robustez_CU07_Gestionar_Proveedores_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU07
' Caso de Uso: CU07 - Gestionar Proveedores y Productos Suministrados
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU07 Gestionar Proveedores y Suministros**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Administrador / Encargado\nde Compras e Insumos" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES) - Colores distintos por cada vista
boundary "Page : Lista de Proveedores" as B_ProvList #AED6F1
boundary "Modal : Formulario Proveedor" as B_ProvModal #A9DFBF

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU07_ProveedorController" as C_Prov

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Proveedor" as E_Prov
entity "ProductoProveedor" as E_ProdProv
entity "Producto" as E_Prod
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_ProvList : <font color="#1B2631">1: consultarProveedores(search, activo) -></font>\n<font color="#1B2631">1.7: mostrarDirectorioProveedores() -></font>
ActAdmin -- B_ProvModal : <font color="#C0392B">2: ingresarDatosProveedor(form) -></font>\n<font color="#C0392B">2.8: proveedorGuardadoExito() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_ProvList -- C_Prov : <font color="#1B2631">1.1: listar_proveedores(Request) -></font>\n<font color="#1B2631">1.6: listaProveedoresResponse() -></font>
B_ProvModal -- C_Prov : <font color="#C0392B">2.1: store() / update() / vincular_producto() -></font>\n<font color="#C0392B">2.7: proveedorProcesado() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Prov -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Prov -- E_Prov : <font color="#1B2631">1.3: filter(tenant_id, activo)->paginate() -></font>\n<font color="#C0392B">2.2: findByNit(nit) -></font>\n<font color="#C0392B">2.3: create() / update(['activo'=>estado]) -></font>
C_Prov -- E_ProdProv : <font color="#1B2631">1.4: with('productos_suministrados')->get() -></font>\n<font color="#C0392B">2.5: syncSuministro(costo_compra) -></font>
C_Prov -- E_Prod : <font color="#1B2631">1.5: with('prenda')->get() -></font>\n<font color="#C0392B">2.4: findOrFail(producto_id) -></font>
C_Prov -- E_Bitacora : <font color="#C0392B">2.6: create(AUDIT_PROVEEDOR) -></font>

@enduml
