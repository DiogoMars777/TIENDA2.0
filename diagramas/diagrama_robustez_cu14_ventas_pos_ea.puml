@startuml Diagrama_Robustez_CU14_Registrar_Ventas_Presenciales_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU14
' Caso de Uso: CU14 - Registrar Ventas Presenciales (Punto de Venta POS)
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU14 Registrar Ventas Presenciales**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cajero / Vendedor\nde Tienda Física" as ActCajero

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES) - Colores distintos por cada vista
boundary "Page : Terminal POS" as B_Pos #AED6F1
boundary "Modal : Recibo / Ticket" as B_Recibo #A9DFBF
boundary "Page : Historial Ventas POS" as B_VentasList #F9E79F
boundary "Modal : Detalle Venta POS" as B_VentaDetail #D7BDE2

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU14_VentaPresencialController" as C_Venta

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Venta" as E_Venta
entity "DetalleVenta" as E_Detalle
entity "MetodoPago" as E_Metodo
entity "Pago" as E_Pago
entity "Cliente" as E_Cliente
entity "Usuario" as E_User
entity "Sucursal" as E_Suc
entity "Inventario" as E_Inv
entity "VarianteProducto" as E_Variante
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCajero -- B_Pos : <font color="#1B2631">1: registrarVenta(items, cliente_ci, metodo_pago) -></font>\n<font color="#1B2631">1.11: ventaProcesadaExito() -></font>
ActCajero -- B_Recibo : <font color="#C0392B">2: imprimirComprobante(venta_id) -></font>\n<font color="#C0392B">2.5: renderizarReciboTermico() -></font>
ActCajero -- B_VentasList : <font color="#1E8449">3: consultarVentasTurno(fecha, sucursal) -></font>\n<font color="#1E8449">3.5: mostrarListaVentasDelDia() -></font>
ActCajero -- B_VentaDetail : <font color="#2980B9">4: verDetalleVenta(venta_id) -></font>\n<font color="#2980B9">4.6: mostrarDesglosePrendasYPago() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_Pos -- C_Venta : <font color="#1B2631">1.1: registrar_venta_presencial(Request) -></font>\n<font color="#1B2631">1.10: ventaCreadaResponse(id, total) -></font>
B_Recibo -- C_Venta : <font color="#C0392B">2.1: generar_recibo_fiscal(venta_id) -></font>\n<font color="#C0392B">2.4: reciboFiscalData() -></font>
B_VentasList -- C_Venta : <font color="#1E8449">3.1: listar_ventas(filtros) -></font>\n<font color="#1E8449">3.4: ventasListResponse() -></font>
B_VentaDetail -- C_Venta : <font color="#2980B9">4.1: obtener_detalle_venta(venta_id) -></font>\n<font color="#2980B9">4.5: detalleVentaResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Venta -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Venta -- E_Suc : <font color="#1B2631">1.3: findOrFail(sucursal_id) -></font>
C_Venta -- E_Cliente : <font color="#1B2631">1.4: findOrCreateByCI(nit_o_ci) -></font>
C_Venta -- E_Variante : <font color="#1B2631">1.5: findOrFail(variante_id) -></font>
C_Venta -- E_Inv : <font color="#1B2631">1.6: descontarStockFisicoDirecto() -></font>
C_Venta -- E_Venta : <font color="#1B2631">1.7: create(total, estado='COMPLETADA') -></font>\n<font color="#C0392B">2.2: findOrFail(venta_id) -></font>\n<font color="#1E8449">3.2: filter(sucursal_id, canal='POS')->paginate() -></font>\n<font color="#2980B9">4.2: findOrFail(venta_id) -></font>
C_Venta -- E_Detalle : <font color="#1B2631">1.8: createMany(prendas_vendidas) -></font>\n<font color="#2980B9">4.3: with('variante.producto')->get() -></font>
C_Venta -- E_Pago : <font color="#1B2631">1.9: create(monto, metodo_id, estado='PAGADO') -></font>
C_Venta -- E_Bitacora : <font color="#C0392B">2.3: create(AUDIT_EMISION_RECIBO) -></font>
C_Venta -- E_User : <font color="#1E8449">3.3: with('cajero')->get() -></font>
C_Venta -- E_Metodo : <font color="#2980B9">4.4: with('metodo_pago')->get() -></font>

@enduml
