@startuml Diagrama_Robustez_CU22_Registrar_Cobros_Contado_Offline_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU22
' Caso de Uso: CU22 - Registrar Cobros de Contado Sin Conexión (Offline)
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU22 Cobros de Contado Offline**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cajero de Sucursal\n(Modo Contingencia Offline)" as ActCajero

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Cobros Offline" as B_OfflineView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU22_CobroOfflineController" as C_CobroOff

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "CobroOffline" as E_CobroOff
entity "Sucursal" as E_Suc
entity "Usuario" as E_User
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCajero -- B_OfflineView : <font color="#1B2631">1: registrarCobroEfectivo(datos_venta, monto) -></font>\n<font color="#1B2631">1.8: generarTicketOfflineConHash() -></font>\n<font color="#C0392B">2: verColaPendientes() -></font>\n<font color="#C0392B">2.5: mostrarListaCobrosPorSincronizar() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_OfflineView -- C_CobroOff : <font color="#1B2631">1.1: registrar_cobro(Request) -></font>\n<font color="#1B2631">1.7: cobroOfflineRegistradoResponse() -></font>\n<font color="#C0392B">2.1: listar_pendientes(sucursal_id) -></font>\n<font color="#C0392B">2.4: listaPendientesResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_CobroOff -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.3: asociarAlTenant() -></font>
C_CobroOff -- E_Suc : <font color="#1B2631">1.3: findOrFail(sucursal_id) -></font>
C_CobroOff -- E_User : <font color="#1B2631">1.4: identifyCajeroLocal() -></font>
C_CobroOff -- E_CobroOff : <font color="#1B2631">1.5: create(codigo_offline, hash_seguridad, estado='PENDIENTE_SYNC') -></font>\n<font color="#C0392B">2.2: filter(sincronizado=False)->get() -></font>
C_CobroOff -- E_Bitacora : <font color="#1B2631">1.6: create(AUDIT_COBRO_OFFLINE) -></font>

@enduml
