@startuml Diagrama_Robustez_CU21_Administrar_Planes_Suscripcion_Tenants_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU21
' Caso de Uso: CU21 - Administrar Planes de Suscripción y Tenants SaaS
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU21 Planes Suscripcion y Tenants**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "SuperAdmin de Plataforma\n(SaaS Owner)" as ActSuperAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Gestión Planes y Tenants" as B_SaaSView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU21_SuscripcionTenantController" as C_SaaS

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "PlanSuscripcion" as E_Plan
entity "Tenant" as E_Tenant
entity "Usuario" as E_User
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActSuperAdmin -- B_SaaSView : <font color="#1B2631">1: consultarPlanesSaaS() -></font>\n<font color="#1B2631">1.6: mostrarMatrizPlanesYLimites() -></font>\n<font color="#C0392B">2: registrarNuevoTenant(nombre, plan_id) -></font>\n<font color="#C0392B">2.8: tenantActivadoExito() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_SaaSView -- C_SaaS : <font color="#1B2631">1.1: listar_planes(Request) -></font>\n<font color="#1B2631">1.5: planesListResponse() -></font>\n<font color="#C0392B">2.1: crear_tenant(payload) -></font>\n<font color="#C0392B">2.7: tenantCreadoResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_SaaS -- E_User : <font color="#1B2631">1.2: validarRolSuperAdmin() -></font>\n<font color="#C0392B">2.5: createTenantAdmin(credenciales) -></font>
C_SaaS -- E_Plan : <font color="#1B2631">1.3: all() -></font>\n<font color="#C0392B">2.2: findOrFail(plan_id) -></font>
C_SaaS -- E_Tenant : <font color="#1B2631">1.4: countTenantsPorPlan() -></font>\n<font color="#C0392B">2.3: findBySlug(slug) -></font>\n<font color="#C0392B">2.4: create(nombre, plan_id, estado='ACTIVO') -></font>
C_SaaS -- E_Bitacora : <font color="#C0392B">2.6: create(AUDIT_ALTA_TENANT) -></font>

@enduml
