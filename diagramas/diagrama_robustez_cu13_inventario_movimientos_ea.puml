@startuml Diagrama_Robustez_CU13_Gestionar_Inventario_Movimientos_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU13
' Caso de Uso: CU13 - Gestionar Inventario y Movimientos
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU13 Gestionar Inventario y Movimientos**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Encargado de Almacén\n/ Administrador" as ActAlmacen

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES) - Colores distintos por cada vista
boundary "Page : Lista de Inventario" as B_InvList #AED6F1
boundary "Modal : Kardex de Movimientos" as B_Kardex #A9DFBF
boundary "Modal : Ajuste de Stock" as B_Ajuste #F9E79F
boundary "Modal : Traslado entre Sucursales" as B_Traslado #D7BDE2

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU13_InventarioController" as C_Inv

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Inventario" as E_Inv
entity "MovimientoInventario" as E_Mov
entity "Sucursal" as E_Suc
entity "Producto" as E_Prod
entity "VarianteProducto" as E_Variante
entity "Usuario" as E_User
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAlmacen -- B_InvList : <font color="#1B2631">1: consultarStock(sucursal, search) -></font>\n<font color="#1B2631">1.8: mostrarTablaInventarioYAlertas() -></font>
ActAlmacen -- B_Kardex : <font color="#C0392B">2: consultarKardex(variante_id) -></font>\n<font color="#C0392B">2.6: mostrarHistorialMovimientos() -></font>
ActAlmacen -- B_Ajuste : <font color="#1E8449">3: registrarAjuste(motivo, cantidad) -></font>\n<font color="#1E8449">3.7: confirmarAjusteStock() -></font>
ActAlmacen -- B_Traslado : <font color="#2980B9">4: ejecutarTraslado(origen, destino, cantidad) -></font>\n<font color="#2980B9">4.8: confirmarTrasladoExitoso() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_InvList -- C_Inv : <font color="#1B2631">1.1: listar_inventario(Request) -></font>\n<font color="#1B2631">1.7: inventarioListResponse() -></font>
B_Kardex -- C_Inv : <font color="#C0392B">2.1: obtener_kardex(variante_id, sucursal_id) -></font>\n<font color="#C0392B">2.5: kardexResponse() -></font>
B_Ajuste -- C_Inv : <font color="#1E8449">3.1: registrar_movimiento(payload) -></font>\n<font color="#1E8449">3.6: ajusteExitosoResponse() -></font>
B_Traslado -- C_Inv : <font color="#2980B9">4.1: registrar_traslado(payload) -></font>\n<font color="#2980B9">4.7: trasladoCompletadoResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Inv -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#1E8449">3.5: asociarAlTenant() -></font>\n<font color="#2980B9">4.6: asociarAlTenant() -></font>
C_Inv -- E_Suc : <font color="#1B2631">1.3: filter(sucursal_id)->first() -></font>\n<font color="#2980B9">4.2: validateSucursales(origen_id, destino_id) -></font>
C_Inv -- E_Inv : <font color="#1B2631">1.4: filter(stock_minimo)->paginate() -></font>\n<font color="#1E8449">3.2: update(['cantidad' => nueva_cantidad]) -></font>\n<font color="#2980B9">4.3: transferStock(origen, destino, cantidad) -></font>
C_Inv -- E_Variante : <font color="#1B2631">1.5: with('prenda.variantes')->get() -></font>\n<font color="#C0392B">2.2: findOrFail(variante_id) -></font>
C_Inv -- E_Prod : <font color="#1B2631">1.6: with('prenda_catalogo')->get() -></font>
C_Inv -- E_Mov : <font color="#C0392B">2.3: filter(variante_id)->orderBy('fecha', 'desc')->get() -></font>\n<font color="#1E8449">3.3: create(tipo='AJUSTE', cantidad, motivo) -></font>\n<font color="#2980B9">4.4: createMany(TRASLADO_SALIDA, TRASLADO_ENTRADA) -></font>
C_Inv -- E_User : <font color="#C0392B">2.4: with('responsable')->get() -></font>
C_Inv -- E_Bitacora : <font color="#1E8449">3.4: create(AUDIT_AJUSTE_INVENTARIO) -></font>\n<font color="#2980B9">4.5: create(AUDIT_TRASLADO) -></font>

@enduml
