@startuml Diagrama_Robustez_CU24_Gestionar_Cancelacion_Vencimiento_Reservas_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU24
' Caso de Uso: CU24 - Gestionar Cancelación y Vencimiento de Reservas (48h)
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU24 Vencimiento de Reservas 48h**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Administrador / Cron\n(Servicio de Vencimiento)" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Auditoría Reservas 48h" as B_VencView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU24_VencimientoReservaController" as C_Venc

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Reserva" as E_Reserva
entity "ReservaDetalle" as E_Detalle
entity "Inventario" as E_Inv
entity "Sucursal" as E_Suc
entity "Usuario" as E_User
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_VencView : <font color="#1B2631">1: auditarReservas48h() -></font>\n<font color="#1B2631">1.7: mostrarTablaReservasExpiradas() -></font>\n<font color="#C0392B">2: purgarReservasExpiradas() -></font>\n<font color="#C0392B">2.8: notificarPurgadoYStockLiberado() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_VencView -- C_Venc : <font color="#1B2631">1.1: auditar_vencimientos(horas=48) -></font>\n<font color="#1B2631">1.6: reservasVencidasList() -></font>\n<font color="#C0392B">2.1: purgar_reservas_vencidas(horas_limite=48) -></font>\n<font color="#C0392B">2.7: resultadoPurgaResponse(total_canceladas) -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Venc -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.6: asociarAlTenant() -></font>
C_Venc -- E_Suc : <font color="#1B2631">1.3: filter(sucursal_id)->all() -></font>
C_Venc -- E_Reserva : <font color="#1B2631">1.4: filter(estado='PENDIENTE', fecha_limite < now())->get() -></font>\n<font color="#C0392B">2.2: update(['estado' => 'VENCIDA_CANCELADA']) -></font>
C_Venc -- E_User : <font color="#1B2631">1.5: with('cliente_usuario')->get() -></font>
C_Venc -- E_Detalle : <font color="#C0392B">2.3: with('items_bloqueados')->get() -></font>
C_Venc -- E_Inv : <font color="#C0392B">2.4: liberarStockBloqueadoADisponible() -></font>
C_Venc -- E_Bitacora : <font color="#C0392B">2.5: create(AUDIT_CANCELACION_VENCIMIENTO_48H) -></font>

@enduml
