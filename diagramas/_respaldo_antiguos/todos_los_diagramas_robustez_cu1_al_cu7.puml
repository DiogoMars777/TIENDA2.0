@startuml Diagrama_Robustez_CU01_Gestionar_Autenticacion_EA
' ==============================================================================
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU01
' Caso de Uso: CU01 - Gestionar Autenticación y Sesiones
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)
' ==============================================================================

title **sd Diagrama de Comunicacion / Robustez - CU01 Gestionar Autenticacion**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' ==============================================================================
' 1. ACTORES
' ==============================================================================
actor "Usuario / Cliente\n(Invitado / Registrado)" as ActUser

' ==============================================================================
' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
' ==============================================================================
boundary "Page : Formulario Login" as B_Login #AED6F1
boundary "Page : Formulario Registro" as B_Register #A9DFBF
boundary "Page : Solicitar Recuperación" as B_Recover #F9E79F
boundary "Page : Restablecer Contraseña" as B_Reset #F5B7B1

' ==============================================================================
' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador en CU01
' ==============================================================================
control "CU01_AuthController" as C_Auth

' ==============================================================================
' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
' ==============================================================================
entity "Usuario" as E_User
entity "Tenant" as E_Tenant
entity "Rol" as E_Rol
entity "Cliente" as E_Cliente
entity "Bitacora" as E_Bitacora

' ==============================================================================
' FLUJOS Y MENSAJES NUMERADOS JERÁRQUICOS CON COLORES POR FLUJO (COMO EN LA FOTO)
' Flujo 1: Negro (#1B2631)
' Flujo 2: Rojo (#C0392B)
' Flujo 3: Verde (#1E8449)
' Flujo 4: Azul (#2980B9)
' ==============================================================================

' --- FLUJO 1: INICIAR SESIÓN (NEGRO) ---
ActUser -- B_Login : <font color="#1B2631">1: ingresarCredenciales(email, pass) -></font>\n<font color="#1B2631">1.8: mostrarDashboardOSesion() -></font>
B_Login -- C_Auth : <font color="#1B2631">1.1: iniciar_sesion(Request) -></font>\n<font color="#1B2631">1.7: tokenJWT(access, refresh) -></font>
C_Auth -- E_Tenant : <font color="#1B2631">1.2: filter(slug, activo=True)->first() -></font>
C_Auth -- E_User : <font color="#1B2631">1.3: findByEmail(email, tenant_id) -></font>\n<font color="#1B2631">1.4: verifyPassword(hash) -></font>
C_Auth -- E_Rol : <font color="#1B2631">1.5: getRolPermisos() -></font>
C_Auth -- E_Bitacora : <font color="#1B2631">1.6: create(LOGIN_EXITOSO) -></font>

' --- FLUJO 2: REGISTRO DE NUEVO USUARIO / CLIENTE (ROJO) ---
ActUser -- B_Register : <font color="#C0392B">2: ingresarDatosRegistro(form) -></font>\n<font color="#C0392B">2.8: cuentaRegistradaExito() -></font>
B_Register -- C_Auth : <font color="#C0392B">2.1: registrar_usuario(Request) -></font>\n<font color="#C0392B">2.7: nuevoUsuarioCreado() -></font>
C_Auth -- E_Tenant : <font color="#C0392B">2.2: validarTenantActivo() -></font>
C_Auth -- E_Rol : <font color="#C0392B">2.3: findByNombre('Cliente') -></font>
C_Auth -- E_User : <font color="#C0392B">2.4: create(cuenta_usuario) -></font>
C_Auth -- E_Cliente : <font color="#C0392B">2.5: create(perfil_cliente) -></font>
C_Auth -- E_Bitacora : <font color="#C0392B">2.6: create(REGISTRO_CLIENTE) -></font>

' --- FLUJO 3: SOLICITAR RECUPERACIÓN DE CONTRASEÑA (VERDE) ---
ActUser -- B_Recover : <font color="#1E8449">3: solicitarRecuperacion(email) -></font>\n<font color="#1E8449">3.6: confirmarCorreoEnviado() -></font>
B_Recover -- C_Auth : <font color="#1E8449">3.1: solicitar_recuperacion(Request) -></font>\n<font color="#1E8449">3.5: tokenRecuperacionGenerado() -></font>
C_Auth -- E_Tenant : <font color="#1E8449">3.2: validarTenantActivo() -></font>
C_Auth -- E_User : <font color="#1E8449">3.3: findByEmail(email) -></font>
C_Auth -- E_Bitacora : <font color="#1E8449">3.4: create(SOLICITUD_RECUPERACION) -></font>

' --- FLUJO 4: RESTABLECER CONTRASEÑA (AZUL) ---
ActUser -- B_Reset : <font color="#2980B9">4: ingresarNuevaPass(token, new_pass) -></font>\n<font color="#2980B9">4.6: confirmacionCambioPassword() -></font>
B_Reset -- C_Auth : <font color="#2980B9">4.1: restablecer_password(Request) -></font>\n<font color="#2980B9">4.5: passwordActualizada() -></font>
C_Auth -- E_User : <font color="#2980B9">4.2: decodeToken()->update(passwordhash) -></font>
C_Auth -- E_Tenant : <font color="#2980B9">4.3: asociarAlTenant() -></font>
C_Auth -- E_Bitacora : <font color="#2980B9">4.4: create(RESET_PASSWORD) -></font>

@enduml
