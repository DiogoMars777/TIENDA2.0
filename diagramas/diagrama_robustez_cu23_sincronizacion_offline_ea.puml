@startuml Diagrama_Robustez_CU23_Sincronizar_Operaciones_Offline_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU23
' Caso de Uso: CU23 - Sincronizar Operaciones Offline
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU23 Sincronizar Operaciones Offline**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cajero / Administrador\nde Sucursal" as ActCajero

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Sincronización Offline" as B_SyncView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU23_SincronizacionOfflineController" as C_Sync

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "CobroOffline" as E_CobroOff
entity "Venta" as E_Venta
entity "DetalleVenta" as E_Detalle
entity "Inventario" as E_Inv
entity "Sucursal" as E_Suc
entity "Usuario" as E_User
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCajero -- B_SyncView : <font color="#1B2631">1: verificarConexionYPendientes() -></font>\n<font color="#1B2631">1.7: mostrarResumenLotePorSincronizar() -></font>\n<font color="#C0392B">2: ejecutarSincronizacion(estrategia) -></font>\n<font color="#C0392B">2.9: notificarSincronizacionCompletada() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_SyncView -- C_Sync : <font color="#1B2631">1.1: validar_lote_sync(sucursal_id) -></font>\n<font color="#1B2631">1.6: loteValidadoResponse() -></font>\n<font color="#C0392B">2.1: sincronizar_pendientes(payload) -></font>\n<font color="#C0392B">2.8: resultadoSincronizacionResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Sync -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.7: asociarAlTenant() -></font>
C_Sync -- E_User : <font color="#1B2631">1.3: findByAuthToken(usuario_id) -></font>
C_Sync -- E_Suc : <font color="#1B2631">1.4: findOrFail(sucursal_id) -></font>
C_Sync -- E_CobroOff : <font color="#1B2631">1.5: filter(sincronizado=False)->all() -></font>\n<font color="#C0392B">2.2: update(['sincronizado' => True, 'fecha_sync' => now()]) -></font>
C_Sync -- E_Venta : <font color="#C0392B">2.3: create(asentarVentaOficial) -></font>
C_Sync -- E_Detalle : <font color="#C0392B">2.4: createMany(prendas) -></font>
C_Sync -- E_Inv : <font color="#C0392B">2.5: resolverConflictoKardexYActualizarStock() -></font>
C_Sync -- E_Bitacora : <font color="#C0392B">2.6: create(AUDIT_SYNC_OFFLINE) -></font>

@enduml
