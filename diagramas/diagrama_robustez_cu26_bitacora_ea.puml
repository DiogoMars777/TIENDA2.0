@startuml Diagrama_Robustez_CU26_Gestionar_Bitacora_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU26
' Caso de Uso: CU26 - Gestionar Bitácora y Auditoría de Seguridad
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU26 Gestionar Bitacora**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Oficial de Seguridad\n/ Administrador del Sistema" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Bitácora de Auditoría" as B_BitView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU26_BitacoraController" as C_Bit

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Bitacora" as E_Bitacora
entity "Usuario" as E_User
entity "Rol" as E_Rol
entity "Tenant" as E_Tenant

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_BitView : <font color="#1B2631">1: consultarEventos(modulo, accion, rango_fechas) -></font>\n<font color="#1B2631">1.7: mostrarTablaEventosSeguridad() -></font>\n<font color="#C0392B">2: exportarCsv(filtros) -></font>\n<font color="#C0392B">2.5: descargarArchivoCsvAuditoria() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_BitView -- C_Bit : <font color="#1B2631">1.1: listar_eventos(filtros, tenant_id) -></font>\n<font color="#1B2631">1.6: eventosListResponse() -></font>\n<font color="#C0392B">2.1: exportar_bitacora_csv(Request) -></font>\n<font color="#C0392B">2.4: archivoCsvStreamResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Bit -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Bit -- E_User : <font color="#1B2631">1.3: validarPermisoAuditoria() -></font>
C_Bit -- E_Bitacora : <font color="#1B2631">1.4: filter(criterios)->orderBy('fechahora', 'desc')->paginate() -></font>\n<font color="#C0392B">2.2: filter(criterios)->all() -></font>\n<font color="#C0392B">2.3: create(AUDIT_EXPORTACION_BITACORA) -></font>
C_Bit -- E_Rol : <font color="#1B2631">1.5: with('usuario.rol')->get() -></font>

@enduml
