@startuml Diagrama_Robustez_CU02_Gestionar_Usuarios_Roles_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU02
' Caso de Uso: CU02 - Gestionar Usuarios y Roles
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU02 Gestionar Usuarios y Roles**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Administrador\n(SuperAdmin / Tenant Admin)" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES) - Colores distintos por cada vista
' Vistas de Usuarios
boundary "Page : Lista de Usuarios" as B_UserList #AED6F1
boundary "Modal : Formulario Usuario" as B_UserForm #A9DFBF
boundary "Modal : Detalle Usuario" as B_UserDetail #F9E79F

' Vistas de Roles
boundary "Page : Lista de Roles" as B_RoleList #D7BDE2
boundary "Modal : Formulario Rol" as B_RoleForm #F5B7B1
boundary "Modal : Matriz Permisos" as B_RolePerms #EDBB99

' 3. CONTROLADORES REALES DEL BACKEND (CONTROLS) - 2 Controladores Físicos
control "CU02_UsuarioController" as C_User
control "CU02_RolController" as C_Rol

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con los Controllers
entity "Usuario" as E_Usuario
entity "Rol" as E_Rol
entity "Tenant" as E_Tenant
entity "PlanSuscripcion" as E_Plan
entity "Cliente" as E_Cliente
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_UserList : <font color="#1B2631">1: consultarUsuarios(search, rol, activo) -></font>\n<font color="#1B2631">1.7: mostrarTablaUsuarios() -></font>
ActAdmin -- B_UserForm : <font color="#C0392B">2: ingresarDatosUsuario(form) -></font>\n<font color="#C0392B">2.9: usuarioGuardadoExito() -></font>
ActAdmin -- B_UserDetail : <font color="#1E8449">3: verDetalleUsuario(id) -></font>\n<font color="#1E8449">3.5: mostrarFichaUsuario() -></font>
ActAdmin -- B_RoleList : <font color="#2980B9">4: consultarRoles() -></font>\n<font color="#2980B9">4.5: mostrarCatalogoRoles() -></font>
ActAdmin -- B_RoleForm : <font color="#8E44AD">5: ingresarDatosRol(form) -></font>\n<font color="#8E44AD">5.7: rolGuardadoExito() -></font>
ActAdmin -- B_RolePerms : <font color="#D35400">6: actualizarPermisos(rol_id, perms) -></font>\n<font color="#D35400">6.6: permisosActualizados() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_UserList -- C_User : <font color="#1B2631">1.1: listar_usuarios(Request) -></font>\n<font color="#1B2631">1.6: listaUsuariosResponse() -></font>
B_UserForm -- C_User : <font color="#C0392B">2.1: store() / update() / baja_logica() -></font>\n<font color="#C0392B">2.8: usuarioProcesado() -></font>
B_UserDetail -- C_User : <font color="#1E8449">3.1: obtener_usuario_por_id(id) -></font>\n<font color="#1E8449">3.4: usuarioDetalleResponse() -></font>
B_RoleList -- C_Rol : <font color="#2980B9">4.1: listar_roles() -></font>\n<font color="#2980B9">4.4: listaRolesResponse() -></font>
B_RoleForm -- C_Rol : <font color="#8E44AD">5.1: store(Request) / update() -></font>\n<font color="#8E44AD">5.6: rolCreado() -></font>
B_RolePerms -- C_Rol : <font color="#D35400">6.1: asignar_permisos_rol(Request) -></font>\n<font color="#D35400">6.5: permisosGuardados() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_User -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_User -- E_Usuario : <font color="#1B2631">1.3: filter(tenant_id)->paginate() -></font>\n<font color="#C0392B">2.3: findByEmail(email) -></font>\n<font color="#C0392B">2.4: create() / update(['activo'=>estado]) -></font>\n<font color="#1E8449">3.2: findOrFail(id) -></font>
C_User -- E_Rol : <font color="#1B2631">1.4: with('rol')->get() -></font>\n<font color="#C0392B">2.5: findById(rol_id) -></font>\n<font color="#1E8449">3.3: getPermisosAsignados() -></font>
C_User -- E_Cliente : <font color="#1B2631">1.5: with('perfil_cliente')->get() -></font>\n<font color="#C0392B">2.6: syncClientePerfil(baja_logica) -></font>
C_User -- E_Plan : <font color="#C0392B">2.2: validarLimiteUsuarios(plan_id) -></font>
C_User -- E_Bitacora : <font color="#C0392B">2.7: create(AUDIT_USUARIO) -></font>
C_Rol -- E_Rol : <font color="#2980B9">4.2: all() -></font>\n<font color="#8E44AD">5.2: findByNombre() -></font>\n<font color="#8E44AD">5.3: create(validated) / update() -></font>\n<font color="#D35400">6.2: findOrFail(rol_id) -></font>\n<font color="#D35400">6.3: sync(permisos_keys) -></font>
C_Rol -- E_Usuario : <font color="#2980B9">4.3: countUsuariosPorRol() -></font>
C_Rol -- E_Bitacora : <font color="#8E44AD">5.4: create(AUDIT_ROL) -></font>\n<font color="#D35400">6.4: create(AUDIT_PERMISOS) -></font>
C_Rol -- E_Tenant : <font color="#8E44AD">5.5: asociarAlTenant() -></font>

@enduml
