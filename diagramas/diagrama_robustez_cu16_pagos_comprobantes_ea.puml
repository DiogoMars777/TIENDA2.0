@startuml Diagrama_Robustez_CU16_Gestionar_Pagos_Comprobantes_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU16
' Caso de Uso: CU16 - Gestionar Pagos y Comprobantes
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU16 Gestionar Pagos y Comprobantes**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Administrador / Cajero\n/ Auditor Financiero" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Gestión de Pagos" as B_PagosList #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU16_PagoController" as C_Pago

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Pago" as E_Pago
entity "MetodoPago" as E_Metodo
entity "ComprobantePago" as E_Comprobante
entity "Venta" as E_Venta
entity "Usuario" as E_User
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_PagosList : <font color="#1B2631">1: consultarPagos(fecha, estado) -></font>\n<font color="#1B2631">1.8: mostrarTablaPagos() -></font>\n<font color="#C0392B">2: procesarPago(venta_id, metodo_id) -></font>\n<font color="#C0392B">2.8: pagoConfirmadoExito() -></font>\n<font color="#1E8449">3: generarComprobante(pago_id) -></font>\n<font color="#1E8449">3.6: descargarComprobantePDF() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_PagosList -- C_Pago : <font color="#1B2631">1.1: listar_pagos(Request) -></font>\n<font color="#1B2631">1.7: pagosListResponse() -></font>\n<font color="#C0392B">2.1: iniciar_pago(payload) -></font>\n<font color="#C0392B">2.7: pasarelaUrlResponse() -></font>\n<font color="#1E8449">3.1: emitir_comprobante(pago_id) -></font>\n<font color="#1E8449">3.5: comprobantePdfResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Pago -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Pago -- E_User : <font color="#1B2631">1.3: findByAuthToken(usuario_id) -></font>
C_Pago -- E_Metodo : <font color="#1B2631">1.4: all() -></font>\n<font color="#C0392B">2.3: findOrFail(metodo_id) -></font>
C_Pago -- E_Pago : <font color="#1B2631">1.5: filter(tenant_id)->paginate() -></font>\n<font color="#C0392B">2.4: create(monto, transaccion_ref, estado='PENDIENTE') -></font>\n<font color="#C0392B">2.5: update(['estado' => 'COMPLETADO']) -></font>\n<font color="#1E8449">3.2: findOrFail(pago_id) -></font>
C_Pago -- E_Venta : <font color="#1B2631">1.6: with('venta_asociada')->get() -></font>\n<font color="#C0392B">2.2: findOrFail(venta_id) -></font>
C_Pago -- E_Bitacora : <font color="#C0392B">2.6: create(AUDIT_TRANSACCION_PAGO) -></font>\n<font color="#1E8449">3.4: create(AUDIT_EMISION_FACTURA) -></font>
C_Pago -- E_Comprobante : <font color="#1E8449">3.3: create(numero_factura, cuf, autorizacion) -></font>

@enduml
