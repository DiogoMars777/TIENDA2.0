@startuml Diagrama_Robustez_CU18_Gestionar_Recomendaciones_IA_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU18
' Caso de Uso: CU18 - Gestionar Recomendaciones Mediante IA
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU18 Gestionar Recomendaciones con IA**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cliente / Comprador\nDigital" as ActCliente

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Recomendaciones IA" as B_RecView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU18_RecomendacionController" as C_Rec

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Producto" as E_Prod
entity "Categoria" as E_Cat
entity "Carrito" as E_Carrito
entity "Usuario" as E_User
entity "Tenant" as E_Tenant

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCliente -- B_RecView : <font color="#1B2631">1: solicitarRecomendacionOutfit(producto_id) -></font>\n<font color="#1B2631">1.7: mostrarCombinacionesSugeridas() -></font>\n<font color="#C0392B">2: solicitarSugerenciasCarrito() -></font>\n<font color="#C0392B">2.7: mostrarPrendasParaCompletarLook() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_RecView -- C_Rec : <font color="#1B2631">1.1: recomendar_outfit(producto_id, tenant_id) -></font>\n<font color="#1B2631">1.6: outfitRecomendadoResponse() -></font>\n<font color="#C0392B">2.1: sugerir_complementos_carrito(usuario_id) -></font>\n<font color="#C0392B">2.6: complementosResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Rec -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.5: asociarAlTenant() -></font>
C_Rec -- E_Prod : <font color="#1B2631">1.3: findOrFail(producto_id)->getEstiloColor() -></font>\n<font color="#1B2631">1.5: searchPrendasComplementarias()->limit(3) -></font>\n<font color="#C0392B">2.4: matchPrendasQueFaltan(calzado, accesorios) -></font>
C_Rec -- E_Cat : <font color="#1B2631">1.4: findCategoriasCompatibles(temporada) -></font>
C_Rec -- E_User : <font color="#C0392B">2.2: findByAuthToken() -></font>
C_Rec -- E_Carrito : <font color="#C0392B">2.3: getPrendasActualesEnCarrito() -></font>

@enduml
