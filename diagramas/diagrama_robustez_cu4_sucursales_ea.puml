@startuml Diagrama_Robustez_CU04_Gestionar_Sucursales_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU04
' Caso de Uso: CU04 - Gestionar Sucursales
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU04 Gestionar Sucursales**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Administrador\n(SuperAdmin / Admin Empresa)" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES) - Colores distintos por cada vista
boundary "Page : Lista de Sucursales" as B_SucList #AED6F1
boundary "Modal : Formulario Sucursal" as B_SucForm #A9DFBF

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU04_SucursalController" as C_Suc

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Sucursal" as E_Sucursal
entity "Tenant" as E_Tenant
entity "PlanSuscripcion" as E_Plan
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_SucList : <font color="#1B2631">1: consultarSucursales(search, ciudad, activo) -></font>\n<font color="#1B2631">1.6: mostrarTablaSucursales() -></font>
ActAdmin -- B_SucForm : <font color="#C0392B">2: ingresarDatosSucursal(form) -></font>\n<font color="#C0392B">2.8: sucursalGuardadaExito() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_SucList -- C_Suc : <font color="#1B2631">1.1: listar_sucursales(Request) -></font>\n<font color="#1B2631">1.5: listaSucursalesResponse() -></font>
B_SucForm -- C_Suc : <font color="#C0392B">2.1: store() / update() / baja_logica() -></font>\n<font color="#C0392B">2.7: sucursalProcesada() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Suc -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.6: asociarAlTenant() -></font>
C_Suc -- E_Sucursal : <font color="#1B2631">1.3: filter(tenant_id, activo)->paginate() -></font>\n<font color="#1B2631">1.4: all() -></font>\n<font color="#C0392B">2.3: findByNombre(nombre) -></font>\n<font color="#C0392B">2.4: create() / update(['activo'=>estado]) -></font>
C_Suc -- E_Plan : <font color="#C0392B">2.2: validarLimiteSucursales(plan_id) -></font>
C_Suc -- E_Bitacora : <font color="#C0392B">2.5: create(AUDIT_SUCURSAL) -></font>

@enduml
