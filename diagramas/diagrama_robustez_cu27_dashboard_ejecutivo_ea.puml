@startuml Diagrama_Robustez_CU27_Dashboard_Ejecutivo_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU27
' Caso de Uso: CU27 - Dashboard Ejecutivo y Analítica Global
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU27 Dashboard Ejecutivo**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Gerente / Propietario\n(Tenant Admin)" as ActGerente

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Dashboard Ejecutivo" as B_DashView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU27_DashboardController" as C_Dash

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Venta" as E_Venta
entity "DetalleVenta" as E_Detalle
entity "Sucursal" as E_Suc
entity "Producto" as E_Prod
entity "Usuario" as E_User
entity "Tenant" as E_Tenant

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActGerente -- B_DashView : <font color="#1B2631">1: abrirDashboardEjecutivo(dias=30) -></font>\n<font color="#1B2631">1.7: mostrarTarjetasKpisIngresos() -></font>\n<font color="#C0392B">2: seleccionarFiltroSucursales() -></font>\n<font color="#C0392B">2.6: renderizarGraficoBarrasSucursal() -></font>\n<font color="#1E8449">3: consultarCanalesVenta() -></font>\n<font color="#1E8449">3.6: renderizarGraficoDonutCanales() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_DashView -- C_Dash : <font color="#1B2631">1.1: obtener_kpis(dias, tenant_id) -></font>\n<font color="#1B2631">1.6: dashboardKpisResponse() -></font>\n<font color="#C0392B">2.1: obtener_ventas_sucursal(dias) -></font>\n<font color="#C0392B">2.5: ventasSucursalResponse() -></font>\n<font color="#1E8449">3.1: obtener_ventas_canal(dias) -></font>\n<font color="#1E8449">3.5: ventasCanalResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Dash -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.4: asociarAlTenant() -></font>\n<font color="#1E8449">3.4: asociarAlTenant() -></font>
C_Dash -- E_User : <font color="#1B2631">1.3: validarRolGerencial() -></font>
C_Dash -- E_Venta : <font color="#1B2631">1.4: sum(total_ventas).count(transacciones) -></font>\n<font color="#C0392B">2.3: groupBy('sucursalid').sum('total') -></font>\n<font color="#1E8449">3.2: groupBy('canal').count().sum('total') -></font>
C_Dash -- E_Detalle : <font color="#1B2631">1.5: sum(prendas_vendidas) -></font>
C_Dash -- E_Suc : <font color="#C0392B">2.2: filter(tenant_id, activo=True)->all() -></font>
C_Dash -- E_Prod : <font color="#1E8449">3.3: topPrendasVendidas(limit=5) -></font>

@enduml
