' ==============================================================================
' FLUJOS Y MENSAJES NUMERADOS JERÁRQUICOS CON COLORES POR FLUJO (COMO EN LA FOTO)
' Flujo 1: Negro (#1B2631) -> Listar Usuarios
' Flujo 2: Rojo (#C0392B)  -> Crear / Editar / Baja Lógica Usuario
' Flujo 3: Verde (#1E8449) -> Detalle Usuario
' Flujo 4: Azul (#2980B9)  -> Listar Roles
' Flujo 5: Morado (#8E44AD) -> Crear / Editar Rol
' Flujo 6: Naranja (#D35400) -> Matriz de Permisos
' ==============================================================================

' --- FLUJO 1: CONSULTAR Y LISTAR USUARIOS (NEGRO) ---
ActAdmin -- B_UserList : <font color="#1B2631">1: consultarUsuarios(search, rol, activo) -></font>\n<font color="#1B2631">1.7: mostrarTablaUsuarios() -></font>
B_UserList -- C_User : <font color="#1B2631">1.1: listar_usuarios(Request) -></font>\n<font color="#1B2631">1.6: listaUsuariosResponse() -></font>
C_User -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_User -- E_Usuario : <font color="#1B2631">1.3: filter(tenant_id)->paginate() -></font>
C_User -- E_Rol : <font color="#1B2631">1.4: with('rol')->get() -></font>
C_User -- E_Cliente : <font color="#1B2631">1.5: with('perfil_cliente')->get() -></font>

' --- FLUJO 2: CREAR / EDITAR / BAJA LÓGICA USUARIO (ROJO) ---
ActAdmin -- B_UserForm : <font color="#C0392B">2: ingresarDatosUsuario(form) -></font>\n<font color="#C0392B">2.9: usuarioGuardadoExito() -></font>
B_UserForm -- C_User : <font color="#C0392B">2.1: store() / update() / baja_logica() -></font>\n<font color="#C0392B">2.8: usuarioProcesado() -></font>
C_User -- E_Plan : <font color="#C0392B">2.2: validarLimiteUsuarios(plan_id) -></font>
C_User -- E_Usuario : <font color="#C0392B">2.3: findByEmail(email) -></font>\n<font color="#C0392B">2.4: create() / update(['activo'=>estado]) -></font>
C_User -- E_Rol : <font color="#C0392B">2.5: findById(rol_id) -></font>
C_User -- E_Cliente : <font color="#C0392B">2.6: syncClientePerfil(baja_logica) -></font>
C_User -- E_Bitacora : <font color="#C0392B">2.7: create(AUDIT_USUARIO) -></font>

' --- FLUJO 3: CONSULTAR DETALLE DE USUARIO (VERDE) ---
ActAdmin -- B_UserDetail : <font color="#1E8449">3: verDetalleUsuario(id) -></font>\n<font color="#1E8449">3.5: mostrarFichaUsuario() -></font>
B_UserDetail -- C_User : <font color="#1E8449">3.1: obtener_usuario_por_id(id) -></font>\n<font color="#1E8449">3.4: usuarioDetalleResponse() -></font>
C_User -- E_Usuario : <font color="#1E8449">3.2: findOrFail(id) -></font>
C_User -- E_Rol : <font color="#1E8449">3.3: getPermisosAsignados() -></font>

' --- FLUJO 4: CONSULTAR Y LISTAR ROLES (AZUL) ---
ActAdmin -- B_RoleList : <font color="#2980B9">4: consultarRoles() -></font>\n<font color="#2980B9">4.5: mostrarCatalogoRoles() -></font>
B_RoleList -- C_Rol : <font color="#2980B9">4.1: listar_roles() -></font>\n<font color="#2980B9">4.4: listaRolesResponse() -></font>
C_Rol -- E_Rol : <font color="#2980B9">4.2: all() -></font>
C_Rol -- E_Usuario : <font color="#2980B9">4.3: countUsuariosPorRol() -></font>

' --- FLUJO 5: CREAR / EDITAR ROL (MORADO) ---
ActAdmin -- B_RoleForm : <font color="#8E44AD">5: ingresarDatosRol(form) -></font>\n<font color="#8E44AD">5.7: rolGuardadoExito() -></font>
B_RoleForm -- C_Rol : <font color="#8E44AD">5.1: store(Request) / update() -></font>\n<font color="#8E44AD">5.6: rolCreado() -></font>
C_Rol -- E_Rol : <font color="#8E44AD">5.2: findByNombre() -></font>\n<font color="#8E44AD">5.3: create(validated) / update() -></font>
C_Rol -- E_Bitacora : <font color="#8E44AD">5.4: create(AUDIT_ROL) -></font>
C_Rol -- E_Tenant : <font color="#8E44AD">5.5: asociarAlTenant() -></font>

' --- FLUJO 6: ASIGNAR MATRIZ DE PERMISOS (NARANJA) ---
ActAdmin -- B_RolePerms : <font color="#D35400">6: actualizarPermisos(rol_id, perms) -></font>\n<font color="#D35400">6.6: permisosActualizados() -></font>
B_RolePerms -- C_Rol : <font color="#D35400">6.1: asignar_permisos_rol(Request) -></font>\n<font color="#D35400">6.5: permisosGuardados() -></font>
C_Rol -- E_Rol : <font color="#D35400">6.2: findOrFail(rol_id) -></font>\n<font color="#D35400">6.3: sync(permisos_keys) -></font>
C_Rol -- E_Bitacora : <font color="#D35400">6.4: create(AUDIT_PERMISOS) -></font>

@enduml
