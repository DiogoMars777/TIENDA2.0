@startuml Diagrama_Robustez_CU08_Consultar_Catalogo_Disponibilidad_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU08
' Caso de Uso: CU08 - Consultar Catálogo y Disponibilidad de Prendas
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU08 Consultar Catalogo y Disponibilidad**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cliente / Comprador\n(Web o Presencial)" as ActCliente

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Catalogo de Prendas" as B_CatPage #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU08_CatalogoController" as C_Cat

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Producto" as E_Prod
entity "VarianteProducto" as E_Variante
entity "Categoria" as E_Cat
entity "Color" as E_Color
entity "Talla" as E_Talla
entity "Inventario" as E_Inv
entity "Sucursal" as E_Suc
entity "Tenant" as E_Tenant

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCliente -- B_CatPage : <font color="#1B2631">1: explorarCatalogo(categoria, genero, search) -></font>\n<font color="#1B2631">1.8: renderizarGrillaProductos() -></font>\n<font color="#C0392B">2: seleccionarPrendaConsultarStock(prod_id) -></font>\n<font color="#C0392B">2.7: mostrarStockPorSucursal() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_CatPage -- C_Cat : <font color="#1B2631">1.1: consultar_catalogo(Request) -></font>\n<font color="#1B2631">1.7: catalogoPaginadoResponse() -></font>\n<font color="#C0392B">2.1: consultar_disponibilidad(prod_id, sucursal_id) -></font>\n<font color="#C0392B">2.6: disponibilidadResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Cat -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Cat -- E_Cat : <font color="#1B2631">1.3: filter(categoria_id)->get() -></font>
C_Cat -- E_Prod : <font color="#1B2631">1.4: filter(activo=True)->paginate() -></font>\n<font color="#C0392B">2.2: findOrFail(prod_id) -></font>
C_Cat -- E_Variante : <font color="#1B2631">1.5: with('variantes')->get() -></font>
C_Cat -- E_Color : <font color="#1B2631">1.6: with('color', 'talla')->resolve() -></font>
C_Cat -- E_Suc : <font color="#C0392B">2.3: filter(tenant_id, activo=True)->all() -></font>
C_Cat -- E_Inv : <font color="#C0392B">2.4: countDisponiblesMenosReservas() -></font>
C_Cat -- E_Talla : <font color="#C0392B">2.5: agruparPorTallaYColor() -></font>

@enduml
