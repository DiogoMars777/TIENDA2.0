@startuml Diagrama_Robustez_CU11_Atender_Reservas_Sucursal_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU11
' Caso de Uso: CU11 - Atender Reservas en Sucursal Física
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU11 Atender Reservas en Sucursal**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cajero / Encargado\nde Sucursal" as ActCajero

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Atención de Reservas" as B_AtenderView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU11_AtenderReservaController" as C_Atender

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Reserva" as E_Reserva
entity "ReservaDetalle" as E_Detalle
entity "Inventario" as E_Inv
entity "MovimientoInventario" as E_Mov
entity "Usuario" as E_User
entity "Sucursal" as E_Suc
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCajero -- B_AtenderView : <font color="#1B2631">1: escanearCodigoReserva(codigo) -></font>\n<font color="#1B2631">1.8: mostrarPrendasYEstado48h() -></font>\n<font color="#C0392B">2: confirmarEntregaPrendas(reserva_id) -></font>\n<font color="#C0392B">2.8: comprobanteEntregaGenerado() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_AtenderView -- C_Atender : <font color="#1B2631">1.1: obtener_reserva_por_codigo(codigo) -></font>\n<font color="#1B2631">1.7: reservaValidaResponse() -></font>\n<font color="#C0392B">2.1: atender_reserva(payload) -></font>\n<font color="#C0392B">2.7: entregaExitosaResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Atender -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.6: asociarAlTenant() -></font>
C_Atender -- E_Suc : <font color="#1B2631">1.3: filter(sucursal_id)->first() -></font>
C_Atender -- E_Reserva : <font color="#1B2631">1.4: findByCodigo(codigo)->validarPlazo48h() -></font>\n<font color="#C0392B">2.2: update(['estado' => 'ENTREGADA']) -></font>
C_Atender -- E_Detalle : <font color="#1B2631">1.5: with('items_variantes')->get() -></font>
C_Atender -- E_User : <font color="#1B2631">1.6: with('datos_cliente')->get() -></font>
C_Atender -- E_Inv : <font color="#C0392B">2.3: descontarDefinitivoStockFisico() -></font>
C_Atender -- E_Mov : <font color="#C0392B">2.4: create(tipo='SALIDA_RESERVA') -></font>
C_Atender -- E_Bitacora : <font color="#C0392B">2.5: create(AUDIT_ATENDER_RESERVA) -></font>

@enduml
