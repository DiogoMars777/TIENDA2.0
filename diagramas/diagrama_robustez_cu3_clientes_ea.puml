@startuml Diagrama_Robustez_CU03_Gestionar_Clientes_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU03
' Caso de Uso: CU03 - Gestionar Clientes y Cuentas de Compradores
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU03 Gestionar Clientes**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Administrador / Cajero\n(Encargado de Ventas)" as ActAdmin

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES) - Colores distintos por cada vista
boundary "Page : Lista de Clientes" as B_CliList #AED6F1
boundary "Modal : Formulario Cliente" as B_CliModal #A9DFBF
boundary "Modal : Detalle Cliente" as B_CliDetail #F9E79F

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU03_ClienteController" as C_Cli

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Cliente" as E_Cliente
entity "Usuario" as E_Usuario
entity "Rol" as E_Rol
entity "Tenant" as E_Tenant
entity "Venta" as E_Venta
entity "Reserva" as E_Reserva
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActAdmin -- B_CliList : <font color="#1B2631">1: consultarClientes(search, activo) -></font>\n<font color="#1B2631">1.7: mostrarTablaClientes() -></font>
ActAdmin -- B_CliModal : <font color="#C0392B">2: ingresarDatosCliente(form) -></font>\n<font color="#C0392B">2.8: clienteGuardadoExito() -></font>
ActAdmin -- B_CliDetail : <font color="#1E8449">3: verDetalleCliente(id) -></font>\n<font color="#1E8449">3.7: mostrarFichaYMetricas() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_CliList -- C_Cli : <font color="#1B2631">1.1: listar_clientes(Request) -></font>\n<font color="#1B2631">1.6: listaClientesResponse() -></font>
B_CliModal -- C_Cli : <font color="#C0392B">2.1: store() / update() / baja_logica() -></font>\n<font color="#C0392B">2.7: clienteProcesado() -></font>
B_CliDetail -- C_Cli : <font color="#1E8449">3.1: obtener_cliente_por_id(id) -></font>\n<font color="#1E8449">3.6: detalleCompletoResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Cli -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>\n<font color="#C0392B">2.6: asociarAlTenant() -></font>
C_Cli -- E_Rol : <font color="#1B2631">1.3: findByNombre('Cliente')->getId() -></font>
C_Cli -- E_Usuario : <font color="#1B2631">1.4: filter(rol_id, tenant_id)->paginate() -></font>\n<font color="#C0392B">2.2: findByEmail(email) -></font>\n<font color="#C0392B">2.3: create() / update(['activo'=>estado]) -></font>
C_Cli -- E_Cliente : <font color="#1B2631">1.5: with('perfil_extendido')->get() -></font>\n<font color="#C0392B">2.4: sync(datos_perfil_cliente) -></font>\n<font color="#1E8449">3.2: findOrFail(id) -></font>
C_Cli -- E_Bitacora : <font color="#C0392B">2.5: create(AUDIT_CLIENTE) -></font>\n<font color="#1E8449">3.5: create(AUDIT_CONSULTA) -></font>
C_Cli -- E_Venta : <font color="#1E8449">3.3: count().sum(total_gastado) -></font>
C_Cli -- E_Reserva : <font color="#1E8449">3.4: with('reservas_prendas')->get() -></font>

@enduml
