@startuml Diagrama_Robustez_CU15_Realizar_Compras_Digitales_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU15
' Caso de Uso: CU15 - Realizar Compras Digitales (Tienda Online)
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU15 Realizar Compras Digitales**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cliente / Comprador\nDigital" as ActCliente

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES) - Colores distintos por cada vista
boundary "Page : Tienda Online" as B_Tienda #AED6F1
boundary "Modal : Checkout Digital" as B_Checkout #A9DFBF
boundary "Page : Mis Pedidos Web" as B_Pedidos #F9E79F

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU15_CompraDigitalController" as C_Compra

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Venta" as E_Venta
entity "DetalleVenta" as E_Detalle
entity "Pago" as E_Pago
entity "MetodoPago" as E_Metodo
entity "Carrito" as E_Carrito
entity "CarritoItem" as E_Item
entity "Usuario" as E_User
entity "Cliente" as E_Cliente
entity "Sucursal" as E_Suc
entity "Inventario" as E_Inv
entity "VarianteProducto" as E_Variante
entity "Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCliente -- B_Tienda : <font color="#1B2631">1: explorarCatalogoOnline() -></font>\n<font color="#1B2631">1.6: mostrarCatalogoDisponible() -></font>
ActCliente -- B_Checkout : <font color="#C0392B">2: confirmarCompra(datos_envio, metodo_pago) -></font>\n<font color="#C0392B">2.14: ordenGeneradaExito() -></font>
ActCliente -- B_Pedidos : <font color="#1E8449">3: consultarMisPedidos() -></font>\n<font color="#1E8449">3.6: mostrarHistorialPedidos() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_Tienda -- C_Compra : <font color="#1B2631">1.1: consultar_catalogo_online(Request) -></font>\n<font color="#1B2631">1.5: catalogoResponse() -></font>
B_Checkout -- C_Compra : <font color="#C0392B">2.1: procesar_orden_digital(Request) -></font>\n<font color="#C0392B">2.13: ordenCreadaResponse(id, tracking) -></font>
B_Pedidos -- C_Compra : <font color="#1E8449">3.1: listar_pedidos_cliente(usuario_id) -></font>\n<font color="#1E8449">3.5: listaPedidosResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Compra -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Compra -- E_Variante : <font color="#1B2631">1.3: with('prenda', 'color', 'talla')->get() -></font>
C_Compra -- E_Inv : <font color="#1B2631">1.4: filterStockOnline() -></font>\n<font color="#C0392B">2.7: descontarStockCentral() -></font>
C_Compra -- E_User : <font color="#C0392B">2.2: findByAuthToken() -></font>
C_Compra -- E_Cliente : <font color="#C0392B">2.3: findByUsuarioId() -></font>
C_Compra -- E_Carrito : <font color="#C0392B">2.4: getActiveCart() -></font>
C_Compra -- E_Item : <font color="#C0392B">2.5: loadCartItems(carrito_id) -></font>
C_Compra -- E_Suc : <font color="#C0392B">2.6: findOrFail(sucursal_id) -></font>
C_Compra -- E_Venta : <font color="#C0392B">2.8: create(total, canal='ONLINE', estado='PAGADA') -></font>\n<font color="#1E8449">3.2: filter(usuario_id, canal='ONLINE')->orderBy('fecha')->get() -></font>
C_Compra -- E_Detalle : <font color="#C0392B">2.9: createMany(items) -></font>\n<font color="#1E8449">3.3: with('prendas')->get() -></font>
C_Compra -- E_Metodo : <font color="#C0392B">2.10: findOrFail(metodo_pago_id) -></font>
C_Compra -- E_Pago : <font color="#C0392B">2.11: create(monto, metodo_id, estado='APROBADO') -></font>\n<font color="#1E8449">3.4: with('comprobante')->get() -></font>
C_Compra -- E_Bitacora : <font color="#C0392B">2.12: create(AUDIT_COMPRA_DIGITAL) -></font>

@enduml
