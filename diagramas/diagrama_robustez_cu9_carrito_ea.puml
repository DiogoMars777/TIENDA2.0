@startuml Diagrama_Robustez_CU09_Gestionar_Carrito_Compras_EA
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU09
' Caso de Uso: CU09 - Gestionar Carrito de Compras
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)

title **sd Diagrama de Comunicacion / Robustez - CU09 Gestionar Carrito de Compras**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam control {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #FFF2CC
    BorderColor #B7950B
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #5D6D7E
    FontColor #1B2631
    FontSize 10
}

' 1. ACTOR
actor "Cliente / Comprador\nRegistrado o Invitado" as ActCliente

' 2. VISTAS REALES DEL FRONTEND (BOUNDARIES)
boundary "Page : Carrito de Compras" as B_CartView #AED6F1

' 3. CONTROLADOR REAL DEL BACKEND (CONTROL) - 1 Solo Controlador Físico
control "CU09_CarritoController" as C_Cart

' 4. ENTIDADES REALES UTILIZADAS (ENTITIES) - Coinciden 1-a-1 con el Controller
entity "Carrito" as E_Carrito
entity "CarritoItem" as E_Item
entity "VarianteProducto" as E_Variante
entity "Producto" as E_Prod
entity "Sucursal" as E_Suc
entity "Inventario" as E_Inv
entity "Usuario" as E_User
entity "Tenant" as E_Tenant

' ==============================================================================
' COMUNICACIONES UNIFICADAS (1 LÍNEA ÚNICA POR ASOCIACIÓN)
' Mensajes ordenados secuencialmente y coloreados por flujo
' ==============================================================================

' --- 1. INTERACCIÓN ACTOR -> BOUNDARY ---
ActCliente -- B_CartView : <font color="#1B2631">1: abrirCarritoCompras() -></font>\n<font color="#1B2631">1.10: renderizarCarritoYSubtotales() -></font>\n<font color="#C0392B">2: modificarItem(variante_id, cantidad) -></font>\n<font color="#C0392B">2.8: notificarCarritoActualizado() -></font>

' --- 2. INVOCACIÓN BOUNDARY -> CONTROL ---
B_CartView -- C_Cart : <font color="#1B2631">1.1: obtener_carrito(Request) -></font>\n<font color="#1B2631">1.9: carritoResponse(items, total) -></font>\n<font color="#C0392B">2.1: agregar_o_actualizar_item(payload) -></font>\n<font color="#C0392B">2.7: itemActualizadoResponse() -></font>

' --- 3. ACCESO A DATOS CONTROL -> ENTITY ---
C_Cart -- E_Tenant : <font color="#1B2631">1.2: validarTenantActivo() -></font>
C_Cart -- E_User : <font color="#1B2631">1.3: findByAuthToken() -></font>
C_Cart -- E_Carrito : <font color="#1B2631">1.4: findActiveCart(usuario_id) -></font>\n<font color="#C0392B">2.4: ensureOpenCart() -></font>
C_Cart -- E_Item : <font color="#1B2631">1.5: loadCartItems(carrito_id) -></font>\n<font color="#C0392B">2.5: createOrUpdate(cantidad) / delete() -></font>
C_Cart -- E_Variante : <font color="#1B2631">1.6: with('variante')->get() -></font>\n<font color="#C0392B">2.2: findOrFail(variante_id) -></font>
C_Cart -- E_Prod : <font color="#1B2631">1.7: with('producto')->get() -></font>
C_Cart -- E_Inv : <font color="#1B2631">1.8: verifyStockEnTiempoReal() -></font>\n<font color="#C0392B">2.3: validarExistenciasSuficientes() -></font>
C_Cart -- E_Suc : <font color="#C0392B">2.6: asignarSucursalRetiro(sucursal_id) -></font>

@enduml
